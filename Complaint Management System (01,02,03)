package codings;
import javax.swing.*;
import java.awt.event.ActionEvent;
import java.awt.event.ActionListener;
import java.util.ArrayList;

// Simple Complaint Class
class ComplaintItem {
    int id;
    String name;
    String category;
    String description;
    String status;

    public ComplaintItem(int id, String name, String category, String description) {
        this.id = id;
        this.name = name;
        this.category = category;
        this.description = description;
        this.status = "Pending";
    }
}

public class MiniProject extends JFrame {
    private ArrayList<ComplaintItem> list = new ArrayList<>();
    private int counter = 1;

    public MiniProject() {
        setTitle("Smart Campus Complaint System");
        setSize(400, 450);
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setLocationRelativeTo(null);
        setLayout(null); // Simple absolute positioning

        // 1. Name Label & Field
        JLabel lblName = new JLabel("Your Name:");
        lblName.setBounds(30, 30, 100, 25);
        add(lblName);

        JTextField txtName = new JTextField();
        txtName.setBounds(140, 30, 200, 25);
        add(txtName);

        // 2. Category Label & ComboBox
        JLabel lblCat = new JLabel("Category:");
        lblCat.setBounds(30, 80, 100, 25);
        add(lblCat);

        String[] categories = {"Classroom", "Laboratory", "Electricity", "Cleanliness", "Other"};
        JComboBox<String> cmbCat = new JComboBox<>(categories);
        cmbCat.setBounds(140, 80, 200, 25);
        add(cmbCat);

        // 3. Description Label & Text Area
        JLabel lblDesc = new JLabel("Description:");
        lblDesc.setBounds(30, 130, 100, 25);
        add(lblDesc);

        JTextArea txtDesc = new JTextArea();
        JScrollPane scroll = new JScrollPane(txtDesc);
        scroll.setBounds(140, 130, 200, 70);
        add(scroll);

        // 4. Submit Button
        JButton btnSubmit = new JButton("Submit Complaint");
        btnSubmit.setBounds(140, 220, 200, 30);
        add(btnSubmit);

        // 5. View Complaints Button
        JButton btnView = new JButton("View All Complaints");
        btnView.setBounds(140, 270, 200, 30);
        add(btnView);

        // Button Click Event for Submitting
        btnSubmit.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                String name = txtName.getText().trim();
                String category = (String) cmbCat.getSelectedItem();
                String desc = txtDesc.getText().trim();

                if (name.isEmpty() || desc.isEmpty()) {
                    JOptionPane.showMessageDialog(null, "Please fill all fields!");
                    return;
                }

                ComplaintItem c = new ComplaintItem(counter++, name, category, desc);
                list.add(c);

                JOptionPane.showMessageDialog(null, "Complaint Registered! ID: " + c.id);
                
                // Clear fields
                txtName.setText("");
                txtDesc.setText("");
            }
        });

        // Button Click Event for Viewing
        btnView.addActionListener(new ActionListener() {
            @Override
            public void actionPerformed(ActionEvent e) {
                if (list.isEmpty()) {
                    JOptionPane.showMessageDialog(null, "No complaints found.");
                    return;
                }

                StringBuilder sb = new StringBuilder();
                for (ComplaintItem c : list) {
                    sb.append("ID: ").append(c.id)
                      .append(" | Name: ").append(c.name)
                      .append(" | Category: ").append(c.category)
                      .append(" | Status: ").append(c.status)
                      .append("\nIssue: ").append(c.description)
                      .append("\n-----------------------------------\n");
                }

                JOptionPane.showMessageDialog(null, sb.toString(), "All Complaints", JOptionPane.INFORMATION_MESSAGE);
            }
        });
    }

    public static void main(String[] args) {
        new MiniProject().setVisible(true);
    }
}
